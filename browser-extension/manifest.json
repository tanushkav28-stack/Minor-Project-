{
  "manifest_version": 3,
  "name": "Cognivibe AI - Mental Health Language Screening",
  "version": "2.0.0",
  "description": "A context-aware, multitask AI extension for analyzing emotion and depression-related language in Hinglish & English social media content.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Cognivibe AI Assistant"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "adapters/reddit.js",
        "adapters/twitter.js",
        "adapters/instagram.js",
        "adapters/youtube.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}

